# App
APP_NAME=job-finder
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/job_finder

# Redis (opcional - Fase 5)
REDIS_URL=redis://redis:6379/0

# Scoring
SCORE_THRESHOLD=60
IMMEDIATE_THRESHOLD=90

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# LLM (opcional - Fase 6) - escolha entre ollama (local, grátis) e openai
LLM_PROVIDER=auto
LLM_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Digest
DIGEST_ENABLED=true
DIGEST_TIME=08:00
