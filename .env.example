# App
APP_NAME=job-finder
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/job_finder

# Redis (opcional - Fase 5)
REDIS_URL=redis://redis:6379/0

# Scoring
SCORE_THRESHOLD=60
IMMEDIATE_THRESHOLD=90

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# LLM (opcional - Fase 6) - escolha entre ollama local, ollama cloud (grátis) e openai
# Local: OLLAMA_BASE_URL=http://localhost:11434 (ou http://ollama:11434 no Docker) + OLLAMA_MODEL=llama3.1:8b
# Cloud gratuito: https://ollama.com (crie conta + API key em https://ollama.com/settings/keys)
#   OLLAMA_BASE_URL=https://ollama.com + OLLAMA_API_KEY=sua_key + OLLAMA_MODEL=gpt-oss:20b-cloud (ou qwen3-coder:480b-cloud, deepseek-v3.1:671b-cloud)
LLM_PROVIDER=auto
LLM_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Digest
DIGEST_ENABLED=true
DIGEST_TIME=08:00

# Fontes (Fase 2) - Greenhouse boards adicionais (comma-separated)
# GREENHOUSE_BOARDS=company1,company2
GREENHOUSE_BOARDS=

# Scheduler (Fase 5) - APScheduler monólito modular, sem Celery
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_COLLECT_ON_START=false

# Display - data/hora brasileira (também em config/search_queries.yaml display)
DISPLAY_TIMEZONE=America/Sao_Paulo
DISPLAY_DATE_FORMAT=%d/%m/%Y às %H:%M
DISPLAY_LOCALE=pt_BR

# Observabilidade (Fase 7)
LOG_FORMAT=text
# LOG_FORMAT=json # para logging estruturado JSON (pronto para Loki/Grafana)
